{
  "name": "genshin-admin-v3",
  "version": "4.21.0",
  "description": "空荧酒馆原神地图点位后台（点位标记系统）",
  "productName": "空荧后厨",
  "author": "Alex Fang <deeno@qq.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:stage": "vite build --mode stage",
    "build:dev": "vite build --mode development",
    "preview": "vite preview --mode development",
    "preview:stage": "vite preview --mode stage",
    "typecheck": "vue-tsc --build --force",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:api": "vitest run --project api-contract --project api-integration",
    "test:parity": "node tests/api/parity/run-parity.mjs",
    "test:parity:java": "vitest run --config vitest.parity.config.ts --mode parity-java",
    "test:parity:rust": "vitest run --config vitest.parity.config.ts --mode parity-rust",
    "test:parity:diff": "node tests/api/parity/diff-report.mjs",
    "test:parity:strict": "node tests/api/parity/run-parity.mjs --strict",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "proto:build": "pbjs -t static-module -w es6 -o src/api/protobuf/compiled.js src/api/protobuf/*.proto && pbts -o src/api/protobuf/compiled.d.ts src/api/protobuf/compiled.js"
  },
  "dependencies": {
