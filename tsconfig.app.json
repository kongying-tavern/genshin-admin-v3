{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["types/**/*", "src/**/*", "tests/**/*"],
  // tests 下的 .mjs 是 Node 命令行编排脚本（run-parity / diff-report），不是浏览器侧代码，
  // 由 tsconfig.node.json 接管；放在这里会被 checkJs 按 DOM+strict 规则逐行报隐式 any。
  "exclude": ["./src/api/protobuf/compiled.js", "tests/**/*.mjs"],
  "compilerOptions": {
    "alwaysStrict": true,
    "checkJs": true,
    "incremental": true,
    "lib": [
      "DOM.AsyncIterable",
      "DOM.Iterable",
      "DOM",
      "ESNext.AsyncIterable",
      "ESNext",
      "WebWorker"
    ],
    "noUnusedLocals": true,
    "paths": {
      "@/*": ["./src/*"],
      "types/*": ["./types/*"]
    },
    "strictNullChecks": true,
    "target": "ESNext",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["element-plus/global", "vite-plugin-pwa/client", "vite-plugin-pwa/vue"],
    "verbatimModuleSyntax": true
  }
}
