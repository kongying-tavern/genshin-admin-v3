## ----------------------- 说明 ----------------------
## 本文件是环境变量清单模板，不会被 Vite / Vitest 加载。
## 仓库不再提交任何 .env / .env.<环境> 实体配置，所有值只由本地文件提供：
##   1. 复制本文件为 .env.<环境>.local，例如
##      .env.development.local / .env.production.local / .env.stage.local / .env.test.local
##   2. 按当前环境填写实际值（标注 (*) 的为必填项）
##   3. Vite / Vitest 根据启动 mode 自动加载对应文件，.env.*.local 已被 .gitignore 忽略
## dev、preview 和 build 会先检查当前模式的 .env.<环境>.local 及其中的必填项。
## dev、preview、build:dev 默认使用 development，build 使用 production，
## build:stage、preview:stage 使用 stage。--mode 可指定其他模式。
## --------------------------------------------------

## ===================== 应用配置 =====================
# 应用标题
VITE_TITLE = '空荧酒馆后厨'

# 历史记录的模式，可选: history | hash | memory
VITE_ROUTER_MODE = 'history'

# 开发模式下自动填充登录表单
VITE_AUTO_COMPLETE_USERNAME = ''
VITE_AUTO_COMPLETE_PASSWORD = ''

# AI 页面句柄默认模式，可选: off | read | write
# 未设置时：开发环境 write，生产环境 off
# 也可以通过 URL ?aiBridge=read|write|off 或 localStorage['__map_ai_bridge'] 临时覆盖
# VITE_AI_BRIDGE = 'off'

# 个人信息卡片的 banner 图片回退地址
VITE_BANNER_IMAGE = 'https://tiles.yuanshen.site/d/res/nmcard/UI_NameCardPic_0_P.png'

# 内嵌文档地址
VITE_DOCUMENT_URL = 'https://yuanshen.site/dash-guide/v3'

## ================== 接口地址与反代理 ==================
# 接口地址 (*)
# 开发环境可填 /api-dev 走 Vite 反代理；vitest 无反代理，必须填绝对地址
VITE_API_BASE = ''

# 接口反代理目标（dev / preview 使用 /api-dev 等同源路径时必填）(*)
VITE_API_PROXY_TARGET = ''

# 开发环境模式，仅影响 vite
  # default 正常
  # offline 离线，离线模式下不会更新接口文件
VITE_DEVELOPMENT_MODE = 'default'

# WebSocket 地址 (*)
VITE_WS_BASE = ''

## ================= 资源服务器与反代理 =================
# 资源服务器地址（底图切片服务器共享该地址）
VITE_ASSETS_BASE = 'https://assets.yuanshen.site'
# 配置存档地址
VITE_CONFIG_ARCHIVE = 'https://assets.yuanshen.site/system.json.bz2'

## ==================== 密钥相关配置 ====================
# 请查看团队 Apifox 文档查看或联系开发组管理员获取
# 在本地创建 .env.*.local 后自行填写

# API前置账号 (*)
VITE_API_AUTH_USERNAME = ''
# API前置口令 (*)
VITE_API_AUTH_PASSWORD = ''

## ==================== 测试专用配置 ====================
# 仅 .env.test.local 需要；接口地址与 WebSocket 复用上面的字段，但必须填绝对地址
# 用于接口集成测试的普通用户账号
VITE_TEST_USERNAME = ''
VITE_TEST_PASSWORD = ''

## ==================== 可选功能开关 ====================
# 开发服务器是否启用 HTTPS
# VITE_HTTPS = '1'
# 已验证归档契约、可按资源启用的实体同步范围，如 marker,item,markerLink
# VITE_MAP_ENTITY_ARCHIVES = ''
